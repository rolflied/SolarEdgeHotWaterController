{
  "entity": {
    "sensor": {
      "heating_level": { "default": "mdi:gauge" },
      "activation_mode": {
        "default": "mdi:robot",
        "state": {
          "manual": "mdi:hand-back-left",
          "schedule": "mdi:calendar-clock",
          "smart_energy": "mdi:solar-power",
          "off": "mdi:power-off"
        }
      },
      "auto_off_reason": {
        "default": "mdi:information-outline",
        "state": { "pending_excess_solar": "mdi:solar-power-variant-outline" }
      },
      "schedule_type": { "default": "mdi:calendar-sync" },
      "device_status": { "default": "mdi:check-network" },
      "rated_power": { "default": "mdi:flash" },
      "total_energy": { "default": "mdi:lightning-bolt" },
      "next_schedule": { "default": "mdi:calendar-clock" },
      "boost_end": { "default": "mdi:timer-sand" }
    },
    "binary_sensor": {
      "heating_active": {
        "default": "mdi:water-boiler-off",
        "state": { "on": "mdi:water-boiler" }
      },
      "excess_pv": {
        "default": "mdi:solar-power-variant-outline",
        "state": { "on": "mdi:solar-power-variant" }
      },
      "schedule_enabled": {
        "default": "mdi:calendar-remove",
        "state": { "on": "mdi:calendar-check" }
      }
    },
    "select": {
      "operation_mode": {
        "default": "mdi:water-boiler",
        "state": {
          "auto": "mdi:water-boiler-auto",
          "on": "mdi:water-boiler",
          "off": "mdi:water-boiler-off",
          "schedule": "mdi:calendar-clock"
        }
      }
    },
    "switch": {
      "manual_heating": {
        "default": "mdi:water-boiler-off",
        "state": { "on": "mdi:water-boiler" }
      }
    },
    "number": {
      "manual_level": { "default": "mdi:gauge" },
      "boost_duration": { "default": "mdi:timer-outline" }
    },
    "button": {
      "boost": { "default": "mdi:rocket-launch" }
    }
  },
  "services": {
    "set_operation_mode": { "service": "mdi:water-boiler" },
    "boost": { "service": "mdi:rocket-launch" }
  }
}
